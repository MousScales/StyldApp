{
  "expo": {
    "name": "Styld",
    "slug": "styld",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crmstyld.app",
      "buildNumber": "9",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": ["arm64"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.crmstyld.app",
      "versionCode": 9,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPhoneOnlyScreens.js",
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "tapToPayCheck": false,
          "locationWhenInUsePermission": "Styld uses your location to accept in-person Tap to Pay payments.",
          "bluetoothPeripheralPermission": "Styld uses Bluetooth to connect to supported card readers.",
          "bluetoothAlwaysUsagePermission": "Styld uses Bluetooth to connect to supported card readers.",
          "localNetworkUsagePermission": "Styld uses your local network to connect to supported card readers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Styld uses your photo library so you can upload photos and videos of your work, business logo, and portfolio media to your booking website."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2b4df120-1511-4aad-ada8-2944efa882d9"
      }
    },
    "owner": "mousappsllc"
  }
}
